# Copy to instances/_shared.env. NEVER commit real values.
#
# Secrets EVERY persona on this machine uses. Loaded after each persona's own
# .env, so a persona that needs its own value for one of these can set it and
# win.
#
# This file exists because the alternative is pasting the same key into every
# instance's .env — which is how 12 of 15 keys came to be duplicated here, and
# how the one key that was NOT duplicated silently dropped a vendor from a
# failover chain for months without a word.
#
# config.yaml refers to these as ${VAR}: the config files carry the shape and
# are reviewable, this file carries the values and is gitignored.

MEMORY_DATABASE_URL=postgres://majordomo:majordomo_local_dev@127.0.0.1:5433/majordomo

ANTHROPIC_API_KEY=                   # optional — Claude also runs keyless
GEMINI_API_KEY=
GROQ_API_KEY=                        # also used for voice transcription
OPENAI_API_KEY=                      # also used for voice transcription
DEEPSEEK_API_KEY=

STATUS_PUSH_URL=
STATUS_PUSH_TOKEN=
