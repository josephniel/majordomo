# Copy to instances/<persona_id>/.env and fill in. Never commit real values.

# ---- required ----
TELEGRAM_TOKEN=                      # from @BotFather
MEMORY_DATABASE_URL=postgres://tc:tc_local_dev@127.0.0.1:5433/telegram_claude

# ---- LLM chain (all optional; at least one backend needed) ----
PRIMARY_LLM=gemini                   # leader when LLM_CHAIN unset
LLM_CHAIN=gemini,claude,groq         # explicit failover order (wins over PRIMARY_LLM)
CLAUDE_ENABLED=1                     # Claude via subscription auth (no key needed)
CLAUDE_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash        # pin explicitly; -latest drifts
GROQ_API_KEY=
GROQ_MODEL=                          # default llama-3.3-70b-versatile
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_ENABLED=                      # local models; keyless, so opt in explicitly
OLLAMA_MODEL=                        # default gemma4:12b (setting this also opts in)
OLLAMA_BASE_URL=                     # default http://localhost:11434/v1
                                     # in docker-compose: http://host.docker.internal:11434/v1
OLLAMA_VISION=                       # 0/1 — can the pulled model see images?
                                     # gemma4 e4b builds CANNOT; 12b and
                                     # qwen3.5 can. Unset = backend default.
OLLAMA_REASONING_EFFORT=             # "none" disables thinking. MODEL-SPECIFIC:
                                     # gemma-family wastes ~16x tokens thinking
                                     # (set none); qwen3.5 NEEDS it to pick tools
                                     # from a big list (leave unset) — measured.

# ---- token/cost caps (0 disables a cap) ----
LLM_MAX_OUTPUT_TOKENS=4096           # per-turn output cap, chat-completions vendors
CLAUDE_MAX_TURNS=50                  # Claude SDK agentic-loop turn cap
CLAUDE_MAX_OUTPUT_TOKENS=16000       # Claude SDK per-response output cap

# ---- background summarization (reflection + compaction) ----
COMPACTION_LLM=claude                # decouple from chat primary to save free quota
COMPACTION_MODEL=claude-haiku-4-5
COMPACTION_DEEP_MODEL=claude-sonnet-5

# ---- voice transcription (LLM-agnostic; unset = voice politely rejected) ----
TRANSCRIPTION_LLM=groq,openai        # vendor order; keys above are reused
TRANSCRIPTION_MODEL=                 # global model override
GROQ_WHISPER_MODEL=                  # per-vendor override (default whisper-large-v3-turbo)
OPENAI_WHISPER_MODEL=                # (default whisper-1)

# ---- schedules / proactivity ----
SCHEDULE_TIMEZONE=                   # YOUR tz, e.g. Asia/Manila — crons/reminders use this wall clock
WEBHOOK_TOKEN=                       # required if persona.yaml configures webhooks
HEARTBEAT_MODEL=claude-haiku-4-5     # heartbeats run on a dedicated cheap agent

# ---- sandboxed code execution ----
CODE_EXEC_IMAGE=python:3.13-slim
CODE_EXEC_NETWORK=none               # think hard before changing

# ---- retention (days; 0 disables an arm; nightly cron + ./manage prune) ----
RETENTION_CHAT_DAYS=180              # archived chat rows = episodic-recall horizon
RETENTION_TURNLOG_DAYS=90
RETENTION_COMMS_DAYS=90
RETENTION_DOCS_DAYS=0                # documents are user-saved; off by default

# ---- status dashboard push (optional) ----
STATUS_PUSH_URL=
STATUS_PUSH_TOKEN=
