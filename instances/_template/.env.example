# Copy to instances/<persona_id>/.env. NEVER commit real values.
#
# SECRETS ONLY. Everything else moved into config files, which are safe to
# commit and can be reviewed in a pull request:
#
#   config.yaml                  the machine: database, local models,
#                                retention, sandbox   (see config.yaml.example)
#   instances/<id>/config.yaml   this assistant: vendor chain, per-role
#                                models, transcription
#                                (see instances/_template/config.yaml.example)
#   instances/<id>/persona.yaml  identity: name, prompt, faculties
#
# Those files reference these variables with ${VAR}, so the shape of a
# deployment is reviewable while the values stay here.
#
# Every variable below ALSO still works as a plain setting, because the
# environment remains the lowest-precedence layer — an .env from before the
# split keeps working unchanged. `./manage doctor <persona>` lists the
# entries that a config file has since superseded.

# ---- this persona's identity on the platform ----
TELEGRAM_TOKEN=                      # from @BotFather

# ---- database ----
# Referenced by config.yaml as ${MEMORY_DATABASE_URL}. Personas may share it.
MEMORY_DATABASE_URL=postgres://tc:tc_local_dev@127.0.0.1:5433/telegram_claude

# ---- LLM vendor credentials (at least one backend is required) ----
# Which vendors are used, in what order, and with which models is
# configuration, not secrets — it lives in instances/<id>/config.yaml.
#
# Two vendors are KEYLESS and so cannot be opted into by supplying a key;
# enable them in config.yaml instead:
#   llm.vendors.claude.enabled: true   Claude Code subscription auth
#   llm.vendors.ollama.enabled: true   local models
ANTHROPIC_API_KEY=                   # optional — Claude also runs keyless
GEMINI_API_KEY=
GROQ_API_KEY=                        # also used for voice transcription
OPENAI_API_KEY=                      # also used for voice transcription
DEEPSEEK_API_KEY=

# ---- proactivity ----
WEBHOOK_TOKEN=                       # required if this persona serves webhooks

# ---- status dashboard push (optional) ----
STATUS_PUSH_TOKEN=
