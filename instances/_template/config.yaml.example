# instances/<id>/config.yaml — PERSONA scope. Copy alongside persona.yaml.
#
# How THIS assistant behaves: which vendors it uses and in what order, which
# model serves which kind of work, its webhook token. Identity — its name,
# system prompt, and which faculties it may use — lives in persona.yaml,
# because "what this assistant is" and "which model summarizes for it" change
# for completely different reasons.
#
# Host-scoped settings (the database, the embedding model, retention) CANNOT
# be set here: personas usually share one database, and the embedding model
# sizes its vector column, so a per-persona value is a way to silently wipe
# another assistant's vectors. Put those in the root config.yaml.
#
# Every key is optional — a persona with nothing unusual about it needs no
# config.yaml at all.

# ------------------------------------------------------------------
skills:
  # Extract standing instructions from idle conversations, alongside fact
  # reflection. Proposals are inert until approved unless auto_save is on.
  # env fallback: SKILL_MINING
  # mine_from_conversations: true

  # Write mined skills active instead of proposed. Off by default — a
  # skill note steers every future turn.
  # env fallback: SKILL_MINING_AUTO_SAVE
  # auto_save_mined: false

  # Corrective messages in one exchange before mining runs. An explicit
  # always/never rule triggers it regardless.
  # env fallback: SKILL_MINING_CORRECTION_THRESHOLD
  # correction_threshold: 2

# ------------------------------------------------------------------
approvals:
  # Write tools that skip the approval prompt on trigger-driven turns only
  # (nobody is watching to tap). Connector name ('budget'), qualified tool
  # ('budget__record_split') or bare tool name. Empty = every write asks.
  # env fallback: BACKGROUND_AUTO_APPROVE
  # background_auto_approve: [gemini, claude, groq]

# ------------------------------------------------------------------
database_connector:
  # statement_timeout for the database connector, in ms. A profile may
  # lower it, never raise it.
  # env fallback: DATABASE_STATEMENT_TIMEOUT_MS
  # statement_timeout_ms: 15000

  # Hard cap on rows one write may touch. This, not the WHERE clause, is
  # what bounds a write.
  # env fallback: DATABASE_MAX_WRITE_ROWS
  # max_write_rows: 50

  # Hard cap on rows a read returns. Also bounds how much a
  # prompt-injected SELECT can move into the chat in one call.
  # env fallback: DATABASE_MAX_ROWS_RETURNED
  # max_rows_returned: 200

  # How long a sql_apply handle stays valid. Expiry is safe: nothing is
  # open server-side, so an expired handle means the write never happened.
  # env fallback: DATABASE_PENDING_WRITE_TTL_SECONDS
  # pending_write_ttl_seconds: 600

# ------------------------------------------------------------------
llm:
  # env fallback: PRIMARY_LLM
  # primary:

  # Failover order, e.g. [gemini, claude, groq]. A vendor with no
  # credentials is dropped — and now says so.
  # env fallback: LLM_CHAIN
  # chain: [gemini, claude, groq]

  # env fallback: LLM_MAX_OUTPUT_TOKENS
  # max_output_tokens: 4096

  # ----------------------------------------------------------------
  vendors:
    # --------------------------------------------------------------
    claude:
      # env fallback: CLAUDE_ENABLED
      # enabled: false

      # env fallback: CLAUDE_MODEL
      # model: claude-sonnet-5

      # env fallback: CLAUDE_MAX_TURNS
      # max_turns: 50

      # env fallback: CLAUDE_MAX_OUTPUT_TOKENS
      # max_output_tokens: 16000

    # --------------------------------------------------------------
    groq:
      # env fallback: GROQ_MODEL
      # model:

    # --------------------------------------------------------------
    gemini:
      # env fallback: GEMINI_MODEL
      # model:

    # --------------------------------------------------------------
    ollama:
      # env fallback: OLLAMA_ENABLED
      # enabled: false

      # env fallback: OLLAMA_MODEL
      # model:

      # env fallback: OLLAMA_REASONING_EFFORT
      # reasoning_effort:

      # env fallback: OLLAMA_VISION
      # vision:

  # ----------------------------------------------------------------
  roles:
    # --------------------------------------------------------------
    background:
      # env fallback: BACKGROUND_LLM_CHAIN
      # chain: [gemini, claude, groq]

      # env fallback: BACKGROUND_MODEL
      # model:

      # env fallback: HEARTBEAT_MODEL
      # heartbeat_model: claude-haiku-4-5

    # --------------------------------------------------------------
    summarize:
      # env fallback: COMPACTION_LLM
      # chain: [gemini, claude, groq]

      # env fallback: COMPACTION_MODEL
      # model: claude-haiku-4-5

      # env fallback: COMPACTION_DEEP_MODEL
      # deep_model: claude-sonnet-5

    # --------------------------------------------------------------
    ideate:
      # env fallback: IDEATE_LLM
      # chain: [gemini, claude, groq]

      # env fallback: IDEATE_MODEL
      # model:

# ------------------------------------------------------------------
transcription:
  # Whisper vendor order. Unset leaves voice notes politely rejected
  # unless one of these vendors has a key.
  # env fallback: TRANSCRIPTION_LLM
  # chain: [groq, openai]

  # Override the model for every vendor in the chain.
  # env fallback: TRANSCRIPTION_MODEL
  # model:

  # ----------------------------------------------------------------
  vendors:
    # --------------------------------------------------------------
    groq:
      # env fallback: GROQ_WHISPER_MODEL
      # model:

    # --------------------------------------------------------------
    openai:
      # env fallback: OPENAI_WHISPER_MODEL
      # model:

# ------------------------------------------------------------------
triggers:
  # ----------------------------------------------------------------
  webhooks:
    # Persona-scoped because each webhook server is one persona's.
    # env fallback: WEBHOOK_TOKEN
    # token: ${WEBHOOK_TOKEN}
