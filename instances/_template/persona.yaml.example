# Copy to instances/<persona_id>/persona.yaml — the persona's IDENTITY.
# Tuning and secrets live in .env; the platform binding in platform.yaml.

name: Assistant

# One short noun phrase completing "<name>, ___" — how the BACKGROUND memory
# prompts refer to this persona. Those prompts (fact extraction, memory
# reconciliation, ideation, compaction) run their own model calls and never
# see system_prompt, so without this they have no idea what they serve.
#
# Keep it to a role, not a personality: it steers what gets treated as a
# durable fact. "an engineering assistant for the payments codebase" and
# "a personal assistant for Sam" want very different things remembered.
# Optional — omit and the prompts use the name alone.
# role: a personal assistant

# Claude model used when the claude vendor serves chat (background/heartbeat
# models are set in .env). Omit to use the CLAUDE_MODEL env default.
# model: claude-sonnet-5

# Enablement grammar (same for both blocks):
#   true            -> active, READ-ONLY (all tools minus write ones)
#   read_write      -> active, ALL tools incl. mutating ones
#   false / omitted -> not loaded
#   list[str]       -> active, only these tool names exposed

# The agent's own faculties — singletons, no accounts, no auth flows.
faculties:
  memory: true
  schedule: true
  tasks: read_write      # the obligations board; every file/close = approval tap
  skills: read_write     # agent may save skills it learns (each save = approval tap)
  delegate: true
  code: read_write       # sandboxed; every run needs an approval tap
  files: true
  documents: read_write
#  jobs: read_write      # named HOST commands (unsandboxed!) — see jobs: below

# External-service adapters — multi-profile, credentialed. Configure
# profiles via ./manage add/auth after enabling. Start read-only (true) and
# grant read_write deliberately: every write still rides the approval gate.
connectors: {}
#  gmail: read_write
#  google_calendar: true
#  google_drive: true     # read-only scope; needed by meeting_watch below
#  clickup: true
#  splitwise: true
#  yahoo: true
#  gitlab: true           # read_write adds MR writes (comment/branch/MR), gated

# Background agents (heartbeat, mail_watch) get THIS toolset instead of the
# chat one — same grammar as faculties:/connectors:. Every background fire
# pays the full tool-schema token cost with no cache reuse, so keep it to
# what the background prompts actually use. Omit to fall back to the chat
# toolset downgraded to read-only.
# background_tools:
#   memory: true
#   gmail: true
#   tasks: read_write      # meeting_watch cannot file anything without this

# Layer 5: every write tool call asks for an inline Approve/Deny tap before
# executing. Only set false if you fully trust every read_write surface.
write_approval: true

system_prompt: |
  You are a personal assistant. Help with email, calendar, tasks, and
  recurring schedules. Keep replies short and direct.

  When using integrations, USE the tools — do not guess, never invent
  senders, content, or data. If a capability isn't listed in your tools,
  you don't have it.

  When a tool call fails, say so plainly with the literal error.

# Proactive check-in: runs `prompt` as an agent turn on this cron
# (SCHEDULE_TIMEZONE wall clock) on a dedicated cheap model
# (HEARTBEAT_MODEL). Re-read every fire; empty prompt = paused.
# heartbeat:
#   cron: "0 8,13,18 * * *"
#   prompt: |
#     Check unread email for anything urgent. Check today's calendar for
#     conflicts. Only message me if something genuinely needs my attention;
#     never send "all clear".

# Push-style mail alerts (needs the gmail connector): a token-free REST
# check every N minutes; the LLM wakes only when new mail arrived.
# mail_watch:
#   every_minutes: 3

# Splitwise -> budget-ledger mirroring (needs splitwise AND budget
# connectors): Splitwise has no webhooks, so a token-free poll every N
# minutes checks get_expenses?updated_after=<watermark>; the LLM wakes only
# for new/edited expenses and records them via record_split /
# record_transaction (writes still ride the approval gate).
# splitwise_watch:
#   every_minutes: 10

# Meeting notes -> task board (needs google_calendar AND google_drive
# connectors, plus the tasks faculty with WRITE access for background fires —
# see background_tools above, or the watch disables itself and says so). A
# token-free Calendar poll finds meetings that just ended; Gemini writes its
# notes doc minutes later, so an ended meeting is re-checked each poll until
# the notes appear or notes_grace_minutes runs out. Only the action items YOU
# own are filed, deduped on the calendar event id so re-read notes never
# double-file.
# meeting_watch:
#   every_minutes: 5
#   notes_grace_minutes: 45   # how long to wait for Gemini before giving up
#   lookback_minutes: 180     # how far back to look for ended meetings
#   calendar_id: primary

# Named HOST commands for the jobs faculty (enable `jobs:` under faculties
# above). UNSANDBOXED on purpose — these exist to touch real repos and real
# tools — so the model can only pick FROM this list, never compose a command,
# and each job_run rides the approval gate. WHEN a job runs is
# conversational: ask in chat ("run the nightly-backup job"), or tell the
# bot to schedule it ("every Monday 9am, run it and send me the report") —
# that lands in the schedule faculty like any reminder. A job printing the
# report_begin/report_end marker lines gets exactly that block relayed;
# otherwise the output tail is.
# jobs:
#   nightly_backup:
#     description: Tar the instance dirs to the NAS
#     command: sh $HOME/backup.sh
#     timeout_minutes: 15
#     report_begin: "REPORT BEGIN"    # optional marker pair
#     report_end: "REPORT END"

# Parameterized job FAMILIES the model may instantiate itself via
# job_propose ("make me a job that syncs X") — for these it composes
# validated params only. It may instead propose a full model-written
# script (requires job_sandbox_profile below; review it with /jobs show
# before approving). Either way, proposals land as INERT drafts in
# data/authored_jobs.json and only the operator's `/jobs approve <name>`
# chat command activates one (approval is deliberately not a tool). The
# approved spec is hash-pinned (drift demotes it to draft), authored jobs
# are capped at 10, run at most hourly after a success (failed runs retry
# immediately — the 3-strike auto-pause bounds failure loops; `/jobs
# resume` clears it), and unapproved drafts expire after 7 days.
# job_templates:
#   mirror_repo:
#     description: Clone-or-sync one GitLab project into ~/projects/work
#     command: sh $HOME/mirror-repo.sh {project}
#     params:
#       project: "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+$"
#     timeout_minutes: 10

# Seatbelt profile (macOS sandbox-exec SBPL, path relative to this dir) that
# confines job commands. Authored jobs ALWAYS run inside it when set;
# operator jobs opt in per-job with `sandbox: true`. Deny at minimum writes
# to this instance dir (the bot's config, credentials, authored-job store and
# job scripts — a job that can edit those can grant itself permissions),
# ~/Library/LaunchAgents, and your VCS identity/credential files.
# job_sandbox_profile: ./jobs/sandbox.sb

# MR activity alerts (needs the gitlab connector): a token-free poll every
# N minutes. A merge request you haven't been told about gets ANNOUNCED —
# a short summary of the proposal, never a review — and one already
# announced reports again when it sees new commits, discussion, a pipeline
# flip, or a state change (merged/closed). Activity that is only your own
# doing stays silent. It never posts to GitLab; reviews happen in chat when
# you ask.
# gitlab_watch:
#   project: group/repo
#   every_minutes: 10

# Event-driven triggers: POST /trigger/<name> with Bearer WEBHOOK_TOKEN.
# webhooks:
#   port: 18790
#   triggers:
#     ci_failed:
#       prompt: "CI failed. Summarize the payload and tell me how bad it is."
