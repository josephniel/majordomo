#!/usr/bin/env bash
# manage — single entry point for the majordomo stack.
#
# All commands run from the project root and assume:
#   - .venv/ exists (`python3 -m venv .venv && ./.venv/bin/pip install -r requirements.txt`)
#   - docker is running locally (for Postgres)
#   - per-instance .env files exist at instances/<id>/.env
#
# Usage: ./manage <command> [args...]
# Run with no args (or `help`) to print the command list.

set -euo pipefail
cd "$(dirname "$0")"

export PYTHONPATH="$(pwd)/src"
VENV_PY="./.venv/bin/python"
DEFAULT_PERSONA="personal_assistant"

# When the default persona doesn't exist (fresh clone), fall back to the
# single persona under instances/, or fail with the list.
detect_persona() {
    if [[ -d "instances/$DEFAULT_PERSONA" ]]; then
        echo "$DEFAULT_PERSONA"; return
    fi
    local found=()
    for d in instances/*/; do
        [[ -f "$d/persona.yaml" ]] && found+=("$(basename "$d")")
    done
    if [[ ${#found[@]} -eq 1 ]]; then
        echo "${found[0]}"; return
    fi
    echo ""
}

# ---- helpers ----

die() { echo "error: $*" >&2; exit 1; }

require_venv() {
    [[ -x "$VENV_PY" ]] || die "$VENV_PY not found. Run: python3 -m venv .venv && ./.venv/bin/pip install -r requirements.txt"
}

require_docker() {
    docker info >/dev/null 2>&1 || die "Docker isn't running. Start Docker Desktop."
}

# Resolve persona arg with default. Accepts as $1 if set; otherwise the
# detected persona (Persona.load prints the available list if this comes
# back empty).
persona_or_default() {
    if [[ -n "${1:-}" ]]; then echo "$1"; else detect_persona; fi
}

cmd_help() {
cat <<'USAGE'
manage — majordomo stack

  Bot lifecycle:
    up [persona]                     start Postgres + run a bot in foreground
                                     (persona defaults to the sole instance)
    bot [persona]                    run a bot only (assumes db is up)
    list-personas                    show every persona under instances/

  Supervision (macOS LaunchAgents — one agent per persona):
    agent-install [persona]          install + load a KeepAlive LaunchAgent
    agent-uninstall [persona]        unload + remove that persona's agent
    agent-restart [persona]          restart it (never kill the PID by hand —
                                     KeepAlive respawns and the two bots then
                                     fight over Telegram getUpdates)
    agent-status                     list every installed majordomo agent

  Postgres:
    db-up                            start Postgres in background
    db-down                          stop the whole compose stack
    db-status                        show Postgres health
    db-shell                         open psql against the running container

  Connectors (passthrough to cli.py — accepts any extra args):
    list [persona]                   list all configured integrations
    show [persona] <connector>       print one connector's full config
    add [persona] <connector> <account> [flags...]    add an integration
    auth [persona] <connector> <account>              re-run OAuth/auth
    enable / disable / remove [persona] <connector> <account>

  Memory (Phase 1 second brain):
    memory inspect [persona]         show core summaries + entry counts
    memory export <dir>              dump memory to a greppable/diffable markdown tree

  Comms (control-room log):
    comms inspect [persona] [limit]  show recent control-room entries (default 20)

  Configuration:
    doctor [persona]                 audit config: dropped vendors, duplicated
                                     keys, dead env entries, shadowed vars,
                                     literal secrets. Offline — safe on a live box.
    doctor --all                     audit every persona
    doctor [persona] --resolved      every setting, its value, and its source
                                     (diff this before/after moving config)

  Introspection & maintenance:
    schedules [persona]              list scheduled tasks (+ timezone)
    skills [persona]                 list skill notes
    documents inspect [persona]      list the document library
    prune [persona]                  run retention now (nightly cron does this too)

  Backup:
    backup [--with-secrets] [dir]    tar the instance dirs (skills, persona
                                     config, watch state) — the only durable
                                     state NOT in Postgres and NOT in git.
                                     Excludes .env / credentials unless asked.

  Misc:
    canary [persona]                 test each LLM vendor actually calls tools
    cli [persona] -- <args...>       raw passthrough to python cli.py
    test [pytest-args...]            run the test suite (unit + integration)
    eval [--vendor groq,gemini]      replay tool-calling evals against live vendors
    eval-recall [-v] [--min-recall]  measure memory recall quality (recall@k, MRR,
                                     false-inject rate) against the test Postgres
    help                             this message

  Examples:
    ./manage up                      # start everything (sole persona auto-detected)
    ./manage memory inspect          # peek at the default persona's memory
    ./manage comms inspect my_assistant 50
    ./manage add my_assistant gmail joe@example.com --oauth-keys ./creds.json
USAGE
}

# ---- bot lifecycle ----

cmd_up() {
    require_docker
    require_venv
    docker volume create majordomo_pgdata >/dev/null
    docker compose up -d postgres
    # Wait briefly for healthcheck.
    until docker compose exec -T postgres pg_isready -U majordomo -d majordomo >/dev/null 2>&1; do
        sleep 1
    done
    local persona; persona="$(persona_or_default "${1:-}")"
    echo "[manage] postgres ready; starting persona=$persona"
    exec "$VENV_PY" -m runtime --persona "$persona"
}

cmd_chat() {
    require_venv
    local persona; persona="$(persona_or_default "${1:-}")"
    exec "$VENV_PY" -m runtime --persona "$persona"
}

cmd_list_personas() {
    for d in instances/*/; do
        local p; p="$(basename "$d")"
        [[ -f "$d/persona.yaml" ]] && echo "$p"
    done
}

# ---- supervision (macOS LaunchAgents) ----
#
# One agent per persona. launchd keys services by label, so a shared label
# would cap the box at a single bot; deriving the label from the persona is
# what makes a second instance an install rather than an edit.

AGENT_PREFIX="com.$(id -un).majordomo"
AGENT_DIR="$HOME/Library/LaunchAgents"

agent_label()     { echo "$AGENT_PREFIX.$1"; }
agent_plist()     { echo "$AGENT_DIR/$(agent_label "$1").plist"; }
agent_target()    { echo "gui/$(id -u)/$(agent_label "$1")"; }

# Resolve the persona and fail loudly if it isn't real — installing an agent
# for a typo'd persona yields a service that crash-loops every 15s forever.
agent_persona() {
    local p; p="$(persona_or_default "${1:-}")"
    [[ -n "$p" ]] || die "no persona given and none could be detected. Try: ./manage list-personas"
    [[ -f "instances/$p/persona.yaml" ]] || die "no such persona: $p (see ./manage list-personas)"
    echo "$p"
}

cmd_agent_install() {
    local persona; persona="$(agent_persona "${1:-}")"
    local tpl="deploy/launchagent.plist.example"
    [[ -f "$tpl" ]] || die "$tpl is missing"
    local plist; plist="$(agent_plist "$persona")"
    local target; target="$(agent_target "$persona")"

    mkdir -p "$AGENT_DIR" logs
    # Unload an existing copy first; bootstrap refuses to load over an
    # already-registered label. bootout returns BEFORE launchd has finished
    # unloading, and bootstrapping into that window fails with a bare
    # "Input/output error" (errno 5) that names nothing — so wait for the
    # label to actually disappear instead of assuming it has.
    if launchctl print "$target" >/dev/null 2>&1; then
        launchctl bootout "$target" 2>/dev/null || true
        local waited=0
        while launchctl print "$target" >/dev/null 2>&1; do
            sleep 1
            waited=$((waited + 1))
            [[ $waited -lt 30 ]] || die "timed out waiting for $(agent_label "$persona") to unload"
        done
    fi

    sed -e "s|__LABEL__|$(agent_label "$persona")|g" \
        -e "s|__PROJECT_DIR__|$(pwd)|g" \
        -e "s|__PERSONA__|$persona|g" \
        "$tpl" > "$plist"
    plutil -lint "$plist" >/dev/null || die "generated plist is malformed: $plist"

    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "[manage] installed $(agent_label "$persona")"
    echo "[manage] logs: logs/$persona.out.log  logs/$persona.err.log"
}

cmd_agent_uninstall() {
    local persona; persona="$(agent_persona "${1:-}")"
    launchctl bootout "$(agent_target "$persona")" 2>/dev/null || true
    rm -f "$(agent_plist "$persona")"
    echo "[manage] removed $(agent_label "$persona")"
}

cmd_agent_restart() {
    local persona; persona="$(agent_persona "${1:-}")"
    launchctl kickstart -k "$(agent_target "$persona")"
    echo "[manage] restarted $(agent_label "$persona")"
}

cmd_backup() {
    # instances/ is gitignored and holds the only state that exists nowhere
    # else: hand-written skills, mined proposals, persona config, watch
    # watermarks. Losing the disk loses work that took real effort to produce.
    local with_secrets=0 dest=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --with-secrets) with_secrets=1 ;;
            -*) echo "unknown flag: $1" >&2; return 1 ;;
            *)  dest="$1" ;;
        esac
        shift
    done
    dest="${dest:-$(pwd)/backups}"
    mkdir -p "$dest" || return 1

    local stamp archive
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    archive="$dest/majordomo-instances-$stamp.tar.gz"

    # Secrets are excluded by DEFAULT. A backup tends to end up somewhere less
    # protected than the box it came from, and API keys are re-issuable while a
    # hand-written skill note is not. Opt in explicitly if you want them.
    local -a excludes=(
        --exclude=__pycache__
        --exclude=.DS_Store
    )
    if [[ "$with_secrets" -eq 0 ]]; then
        excludes+=(
            --exclude=.env
            --exclude=_shared.env
            --exclude=credentials
        )
    fi

    tar -czf "$archive" -C "$(pwd)" "${excludes[@]}" instances || return 1

    echo "[manage] wrote $archive"
    echo "         $(du -h "$archive" | cut -f1)  $(tar -tzf "$archive" | wc -l | tr -d " ") entries"
    if [[ "$with_secrets" -eq 0 ]]; then
        echo "         secrets EXCLUDED (.env, _shared.env, credentials/)."
        echo "         re-auth after a restore, or use --with-secrets."
    else
        echo "         WARNING: contains API keys in plaintext. Store it encrypted."
    fi
    echo "         Postgres is NOT in here — memory, history and the approval"
    echo "         log live there. Dump it separately if you need those."
}

cmd_agent_status() {
    # Columns are PID / last exit / label.
    local found
    found="$(launchctl list | grep "$AGENT_PREFIX" || true)"
    if [[ -z "$found" ]]; then
        echo "no majordomo agents installed"
    else
        echo "PID     EXIT    LABEL"
        echo "$found"
    fi
}

# ---- postgres ----

cmd_db_up() {
    require_docker
    # The data volume is declared external so `db-down` can never delete it;
    # create it on first run.
    docker volume create majordomo_pgdata >/dev/null
    docker compose up -d postgres
}
cmd_db_down()   { require_docker; docker compose down; }
cmd_db_status() { require_docker; docker compose ps postgres; }
cmd_db_shell() {
    require_docker
    docker compose exec postgres psql -U majordomo -d majordomo
}

# ---- connector passthrough ----

# Many cli.py subcommands take `--persona <id>` then `<verb> <args...>`. We accept
# the persona as either an explicit first positional (if it matches a known
# persona dir) or fall back to the default. Subsequent args go to cli.py.

resolve_persona_arg() {
    # Echoes "persona arg1 arg2 ..." with the persona disambiguated.
    if [[ $# -ge 1 && -d "instances/$1" ]]; then
        echo "$@"
    else
        echo "$(detect_persona) $@"
    fi
}

cmd_passthrough() {
    # $1 = the cli.py verb (list / show / add / auth / enable / disable / remove)
    require_venv
    local verb="$1"; shift
    # shellcheck disable=SC2046
    set -- $(resolve_persona_arg "$@")
    local persona="$1"; shift
    exec "$VENV_PY" cli.py --persona "$persona" "$verb" "$@"
}

cmd_list()    { cmd_passthrough list "$@"; }
cmd_show()    { cmd_passthrough show "$@"; }
cmd_add()     { cmd_passthrough add "$@"; }
cmd_auth()    { cmd_passthrough auth "$@"; }
cmd_enable()  { cmd_passthrough enable "$@"; }
cmd_disable() { cmd_passthrough disable "$@"; }
cmd_remove()  { cmd_passthrough remove "$@"; }

# ---- memory + comms ----

cmd_memory() {
    require_venv
    local action="${1:-}"
    [[ -n "$action" ]] || die "usage: ./manage memory <inspect> [persona]"
    shift
    # shellcheck disable=SC2046
    set -- $(resolve_persona_arg "$@")
    local persona="$1"; shift
    exec "$VENV_PY" cli.py --persona "$persona" memory "$action" "$@"
}

cmd_canary() {
    require_venv
    # shellcheck disable=SC2046
    set -- $(resolve_persona_arg "$@")
    local persona="$1"; shift
    exec "$VENV_PY" cli.py --persona "$persona" canary
}

cmd_documents() {
    require_venv
    local action="${1:-inspect}"
    case "$action" in inspect) shift || true ;; *) action="inspect" ;; esac
    # shellcheck disable=SC2046
    set -- $(resolve_persona_arg "$@")
    local persona="$1"; shift
    exec "$VENV_PY" cli.py --persona "$persona" documents "$action"
}

# Simple one-word cli passthroughs: ./manage <verb> [persona]
cmd_simple_cli() {
    local verb="$1"; shift
    require_venv
    # shellcheck disable=SC2046
    set -- $(resolve_persona_arg "$@")
    local persona="$1"; shift
    exec "$VENV_PY" cli.py --persona "$persona" "$verb" "$@"
}

cmd_comms() {
    require_venv
    local action="${1:-}"
    [[ -n "$action" ]] || die "usage: ./manage comms <inspect> [persona] [limit]"
    shift
    # First arg might be persona, second might be limit.
    local persona limit_args=()
    if [[ $# -ge 1 && -d "instances/$1" ]]; then
        persona="$1"; shift
    else
        persona="$DEFAULT_PERSONA"
    fi
    if [[ $# -ge 1 ]]; then
        limit_args+=(--limit "$1")
        shift
    fi
    exec "$VENV_PY" cli.py --persona "$persona" comms "$action" "${limit_args[@]}"
}

# ---- configuration audit ----

cmd_doctor() {
    require_venv
    # No persona resolution: doctor takes an optional persona, supports
    # --all, and must run even when nothing is configured yet.
    PYTHONPATH=src exec "$VENV_PY" -m runtime.doctor "$@"
}

# ---- raw cli passthrough ----

cmd_cli() {
    require_venv
    # shellcheck disable=SC2046
    set -- $(resolve_persona_arg "$@")
    local persona="$1"; shift
    # Strip leading "--" if the user used `./manage cli persona -- args`.
    [[ "${1:-}" == "--" ]] && shift
    exec "$VENV_PY" cli.py --persona "$persona" "$@"
}

# ---- dispatcher ----

main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        help|--help|-h|"")  cmd_help ;;
        up)                 cmd_up "$@" ;;
        bot)                cmd_chat "$@" ;;
        list-personas)      cmd_list_personas ;;
        doctor)             cmd_doctor "$@" ;;
        agent-install)      cmd_agent_install "$@" ;;
        agent-uninstall)    cmd_agent_uninstall "$@" ;;
        agent-restart)      cmd_agent_restart "$@" ;;
        agent-status)       cmd_agent_status ;;
        backup)             cmd_backup "$@" ;;
        db-up)              cmd_db_up ;;
        db-down)            cmd_db_down ;;
        db-status)          cmd_db_status ;;
        db-shell)           cmd_db_shell ;;
        list)               cmd_list "$@" ;;
        show)               cmd_show "$@" ;;
        add)                cmd_add "$@" ;;
        auth)               cmd_auth "$@" ;;
        enable)             cmd_enable "$@" ;;
        disable)            cmd_disable "$@" ;;
        remove)             cmd_remove "$@" ;;
        memory)             cmd_memory "$@" ;;
        canary)             cmd_canary "$@" ;;
        comms)              cmd_comms "$@" ;;
        schedules)          cmd_simple_cli schedules "$@" ;;
        skills)             cmd_simple_cli skills "$@" ;;
        documents)          cmd_documents "$@" ;;
        prune)              cmd_simple_cli prune "$@" ;;
        cli)                cmd_cli "$@" ;;
        test)               require_venv; exec "$VENV_PY" -m pytest tests "$@" ;;
        eval)               require_venv; exec "$VENV_PY" -m evals "$@" ;;
        eval-recall)        require_venv; exec "$VENV_PY" -m evals.recall "$@" ;;
        *)
            echo "unknown command: $cmd" >&2
            echo "" >&2
            cmd_help >&2
            exit 1
            ;;
    esac
}

main "$@"
