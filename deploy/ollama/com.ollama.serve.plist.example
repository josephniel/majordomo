<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ollama tuned for a SINGLE-USER agent on Apple Silicon (measured on a
  Mac mini M4 / 24GB). Copy to ~/Library/LaunchAgents/com.ollama.serve.plist,
  then:  launchctl load ~/Library/LaunchAgents/com.ollama.serve.plist
  (stop the manual `ollama serve` first, or the port is taken.)

  Every value below fixes a default that is wrong for this workload:

  OLLAMA_KEEP_ALIVE=-1      Ollama unloads an idle model after 5 MINUTES.
                            Reloading costs a full cold prefill: measured
                            ~100s for gemma4:12b on an 11.6k-token prompt vs
                            0.61s warm. For a chat bot messaged a few times an
                            hour, the DEFAULT MEANS EVERY TURN IS COLD — this
                            single setting is the difference between a ~2s
                            reply and a ~110s one. Cost: the model stays
                            resident (~8GB). That is the trade, and on 24GB
                            for a daily-driver bot it is worth it.

  OLLAMA_MAX_LOADED_MODELS=1  Default keeps up to 3 models in memory at once.
                            Observed live: two llama-servers holding 12.4GB
                            with 0.0GB free and 121k pageouts — swapping,
                            which is far slower than any model choice.

  OLLAMA_NUM_PARALLEL=1     Parallel slots DIVIDE the context window between
                            them and multiply KV cache. One user, one slot:
                            full context and the whole prompt cache for it.

  OLLAMA_CONTEXT_LENGTH     Ollama caps context at 4096 for EVERY model
                            regardless of what it supports, and /v1 ignores
                            per-request options — so this is the only global
                            way to fix it. At 4096 this agent's ~12k-token
                            prompt overflows and the SYSTEM PROMPT is dropped.
                            131072, and each earlier ceiling was raised only
                            after a real turn blew through it: a plain turn is
                            ~15.5k tokens, one returning TOOL RESULTS hit
                            35,197, and a multi-tool budget-split turn hit
                            67,409 — overflowing 65536 and truncating away the
                            system prompt, which reads as the bot suddenly
                            reasoning badly. Raising this costs nothing until
                            the tokens are actually used, so err high.

  OLLAMA_FLASH_ATTENTION=1  Faster attention, less KV memory on Metal.
  OLLAMA_KV_CACHE_TYPE=f16  Measured: q8_0 was SLOWER here (10.5 vs 11.6
                            tok/s), so the usual "quantize the KV cache"
                            advice is a pessimization on this box. Kept f16.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ollama.serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/ollama</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>-1</string>
        <key>OLLAMA_MAX_LOADED_MODELS</key>
        <string>1</string>
        <key>OLLAMA_NUM_PARALLEL</key>
        <string>1</string>
        <key>OLLAMA_CONTEXT_LENGTH</key>
        <string>131072</string>
        <key>OLLAMA_FLASH_ATTENTION</key>
        <string>1</string>
        <key>OLLAMA_KV_CACHE_TYPE</key>
        <string>f16</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ollama.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ollama.err.log</string>
</dict>
</plist>
